#!/bin/bash
set -e
cd "$(dirname "$0")/.."

trap 'echo "FAILED (exit code: $?)"' ERR

hash shellcheck 2>/dev/null || { echo >&2 "shellcheck command required, aborting."; exit 1; }

shellcheck -s bash bash_profile bashrc shell.d/*.sh bin/* test/*.sh
shellcheck -s bash zshrc 2>/dev/null || true

bash -i -c 'exit' 2>&1 | grep -Ev "no job control|^exit$|^zsh now fully supported" || true
zsh -i -c 'exit' || echo "zsh -i had a non-zero exit code"

test/upsert-content.sh
test/reload.sh bash
test/reload.sh zsh
bin/test-install --fresh .

# Test upgrade from recent milestones in parallel
milestones=$(bin/list-milestones 30 | tail -5)
pids=()
results_dir=$(mktemp -d)
# shellcheck disable=SC2064 # intentional: expand path now so cleanup uses the right dir
trap "rm -rf ${results_dir:?}" EXIT

while read -r hash rest; do
  (
    if bin/test-install "$hash" . >/dev/null 2>&1; then
      touch "$results_dir/$hash.ok"
    else
      touch "$results_dir/$hash.fail"
    fi
  ) &
  pids+=($!)
done <<< "$milestones"

for pid in "${pids[@]}"; do
  wait "$pid" 2>/dev/null || true
done

failed=0
while read -r hash date time rest; do
  if [ -f "$results_dir/$hash.fail" ]; then
    echo "FAIL: upgrade from $hash $date $time"
    failed=1
  else
    echo "  OK: upgrade from $hash $date $time"
  fi
done <<< "$milestones"

if [ "$failed" -ne 0 ]; then
  exit 1
fi

echo "SUCCESS"
