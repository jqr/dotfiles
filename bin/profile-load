#!/bin/bash
# Profile shell startup time, broken down by shell.d file.
#
# Usage: bin/profile-load [bash|zsh]
#
# Requires: hyperfine (brew install hyperfine)

set -e
cd "$(dirname "$0")/.."

hash hyperfine 2>/dev/null || { echo >&2 "hyperfine required: brew install hyperfine"; exit 1; }

profile_shell() {
  local shell="$1"

  local cmds=()
  for f in shell.d/*.sh; do
    cmds+=(-n "$f" "$shell -c '. $f'")
  done
  cmds+=(-n "$shell -i (without shell.d)" "env DOTFILES_SKIP_SHELL_D=1 $shell -i -c exit")
  cmds+=(-n "$shell -i (total)" "$shell -i -c exit")

  echo "=== $shell ==="
  hyperfine \
    --shell=none \
    --warmup 1 \
    --style full \
    --time-unit millisecond \
    --sort mean-time \
    --ignore-failure \
    "${cmds[@]}" 2>/dev/null
}

if [ $# -gt 0 ]; then
  for s in "$@"; do
    profile_shell "$s"
  done
else
  profile_shell bash
  echo ""
  profile_shell zsh
fi
