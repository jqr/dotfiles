#!/bin/bash
set -e

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"

if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: script/test-milestone-upgrade <days>"
  echo ""
  echo "For each milestone commit (settled for at least <days> days),"
  echo "installs that version then upgrades to the current working tree."
  echo "Verifies bash and zsh start cleanly after upgrade."
  echo ""
  echo "Examples:"
  echo "  script/test-milestone-upgrade 30   # 30-day milestones"
  echo "  script/test-milestone-upgrade 90   # 90-day milestones"
  exit 1
fi

min_gap="$1"
max_jobs="${2:-8}"

green='\033[0;32m'
red='\033[0;31m'
yellow='\033[0;33m'
nc='\033[0m'

milestones=$("$repo_dir/script/install-milestones" "$min_gap")
total=$(echo "$milestones" | wc -l | tr -d ' ')

echo "Testing upgrade from $total milestones (${min_gap}+ day gaps) to current..."
echo ""

results_dir=$(mktemp -d)
trap "rm -rf $results_dir" EXIT

test_milestone() {
  local current_hash="$1"
  local result_file="$results_dir/$current_hash"

  local temp_repo temp_home
  temp_repo=$(mktemp -d)
  temp_home=$(mktemp -d)

  git clone --quiet "$repo_dir" "$temp_repo"
  git -C "$temp_repo" checkout --quiet "$current_hash" -- .
  HOME="$temp_home" rake -f "$temp_repo/Rakefile" install --quiet >/dev/null 2>&1 || true

  rsync -a --exclude=.git "$repo_dir/" "$temp_repo/"
  HOME="$temp_home" rake -f "$temp_repo/Rakefile" install --quiet >/dev/null 2>&1 || {
    echo "rake install failed" > "$result_file.fail"
    rm -rf "$temp_repo" "$temp_home"
    return
  }

  local output
  output=$(HOME="$temp_home" bash -i -c 'exit' 2>&1 | grep -Ev "no job control|^exit$" || true)
  if [ -n "$output" ]; then
    echo "bash: $output" > "$result_file.fail"
    rm -rf "$temp_repo" "$temp_home"
    return
  fi

  if [ -f "$temp_repo/zshrc" ]; then
    output=$(HOME="$temp_home" zsh -i -c 'exit' 2>&1 || true)
    if [ -n "$output" ]; then
      echo "zsh: $output" > "$result_file.fail"
      rm -rf "$temp_repo" "$temp_home"
      return
    fi
  fi

  touch "$result_file.ok"
  rm -rf "$temp_repo" "$temp_home"
}

pids=()
labels=()
hashes=()

while read -r current_hash current_date current_time rest; do
  labels+=("${current_date} ${current_time} ${current_hash}")
  hashes+=("$current_hash")
  test_milestone "$current_hash" &
  pids+=($!)

  if [ "${#pids[@]}" -ge "$max_jobs" ]; then
    wait "${pids[0]}"
    pids=("${pids[@]:1}")
  fi
done <<< "$milestones"

# Print results in order as they complete
failed=0
for i in "${!hashes[@]}"; do
  # Wait for this specific job if still running
  if [ -n "${pids[$i]+x}" ]; then
    wait "${pids[$i]}" 2>/dev/null || true
  fi

  # Poll until result file appears
  while [ ! -f "$results_dir/${hashes[$i]}.ok" ] && [ ! -f "$results_dir/${hashes[$i]}.fail" ]; do
    sleep 0.1
  done

  if [ -f "$results_dir/${hashes[$i]}.fail" ]; then
    echo -e "${yellow}${labels[$i]}${nc} -> current ... ${red}FAIL${nc}"
    echo "  $(cat "$results_dir/${hashes[$i]}.fail")"
    failed=1
  else
    echo -e "${yellow}${labels[$i]}${nc} -> current ... ${green}OK${nc}"
  fi
done

echo ""
passed=$((total - failed))
if [ "$failed" -eq 0 ]; then
  echo -e "${green}All $total milestones passed.${nc}"
else
  echo -e "${passed}/${total} passed, ${red}${failed} failed${nc}."
fi

exit $((failed > 0))
