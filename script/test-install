#!/bin/bash
set -e

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"

if [ $# -eq 0 ]; then
  echo "Usage: script/test-install <rev> [<rev> ...]"
  echo ""
  echo "Installs each revision in order into a temporary HOME and"
  echo "verifies bash and zsh start cleanly after each step."
  echo "Use '.' for the current working tree."
  echo ""
  echo "Examples:"
  echo "  script/test-install .              # test working tree"
  echo "  script/test-install HEAD~1 HEAD .  # test upgrade path"
  exit 1
fi

temp_home=$(mktemp -d)
temp_repo=$(mktemp -d)
trap "rm -rf $temp_home $temp_repo" EXIT

git clone --quiet "$repo_dir" "$temp_repo"

for rev in "$@"; do
  if [ "$rev" = "." ]; then
    label="(working tree)"
    rsync -a --exclude=.git "$repo_dir/" "$temp_repo/"
  else
    git -C "$temp_repo" checkout --quiet "$rev" -- .
    label=$(git -C "$temp_repo" log --oneline -1 "$rev" 2>/dev/null) || {
      echo "FAIL: unknown revision $rev"
      exit 1
    }
  fi
  echo "=== Installing: $label ==="

  HOME="$temp_home" rake -f "$temp_repo/Rakefile" install --quiet

  output=$(HOME="$temp_home" bash -i -c 'exit' 2>&1 | grep -Ev "no job control|^exit$" || true)
  if [ -n "$output" ]; then
    echo "FAIL: bash produced unexpected output after installing $rev:"
    echo "$output"
    exit 1
  fi

  if [ -f "$temp_repo/zshrc" ]; then
    output=$(HOME="$temp_home" zsh -i -c 'exit' 2>&1 || true)
    if [ -n "$output" ]; then
      echo "FAIL: zsh produced unexpected output after installing $rev:"
      echo "$output"
      exit 1
    fi
  fi

  # Verify key function is defined
  output=$(HOME="$temp_home" bash -i -c 'type gs' 2>&1 | grep -Ev "no job control|^exit$" || true)
  if ! echo "$output" | grep -q "function\|alias"; then
    echo "FAIL: gs not defined after installing $rev"
    exit 1
  fi

  # Verify completion is loaded
  output=$(HOME="$temp_home" bash -i -c 'complete -p gd' 2>&1 | grep -Ev "no job control|^exit$" || true)
  if ! echo "$output" | grep -q "complete"; then
    echo "FAIL: gd completion not loaded after installing $rev"
    exit 1
  fi

  # Verify EDITOR is set
  output=$(HOME="$temp_home" bash -i -c 'echo "$EDITOR"' 2>&1 | grep -Ev "no job control|^exit$" || true)
  if [ -z "$output" ]; then
    echo "FAIL: EDITOR not set after installing $rev"
    exit 1
  fi

  # Verify no stale symlinks pointing into our repo
  dotfiles_dir=$(cd "$temp_repo" && pwd -P)
  for link in "$temp_home"/.*; do
    [ -L "$link" ] || continue
    target=$(readlink "$link")
    target=$(cd "$(dirname "$link")" && cd "$(dirname "$target")" && echo "$(pwd -P)/$(basename "$target")")
    if [[ "$target" == "$dotfiles_dir/"* ]] && [ ! -e "$link" ]; then
      echo "FAIL: stale symlink $link -> $target after installing $rev"
      exit 1
    fi
  done

  echo "  OK"
done
