#!/bin/bash
set -e
cd "$(dirname "$0")/.."

hash shellcheck 2>/dev/null || { echo >&2 "shellcheck command required, aborting."; exit 1; }

shellcheck -s bash bash_profile bashrc shell.d/*.sh script/*
shellcheck -s bash zshrc 2>/dev/null || true

output=$(bash -i -c 'exit' 2>&1 | grep -Ev "no job control|^exit$" || true)
if [ -n "$output" ]; then
  echo "bash interactive produced unexpected output:"
  echo "$output"
  exit 1
fi

output=$(zsh -i -c 'exit' 2>&1)
if [ -n "$output" ]; then
  echo "zsh interactive produced unexpected output:"
  echo "$output"
  exit 1
fi

script/test-insert-content
script/test-install --fresh .

# Test upgrade from recent milestones in parallel
milestones=$(script/install-milestones 30 | tail -5)
pids=()
results_dir=$(mktemp -d)
# shellcheck disable=SC2064 # intentional: expand path now so cleanup uses the right dir
trap "rm -rf ${results_dir:?}" EXIT

while read -r hash rest; do
  (
    if script/test-install "$hash" . >/dev/null 2>&1; then
      touch "$results_dir/$hash.ok"
    else
      touch "$results_dir/$hash.fail"
    fi
  ) &
  pids+=($!)
done <<< "$milestones"

for pid in "${pids[@]}"; do
  wait "$pid" 2>/dev/null || true
done

failed=0
while read -r hash date time rest; do
  if [ -f "$results_dir/$hash.fail" ]; then
    echo "FAIL: upgrade from $hash $date $time"
    failed=1
  else
    echo "  OK: upgrade from $hash $date $time"
  fi
done <<< "$milestones"

if [ "$failed" -ne 0 ]; then
  exit 1
fi
